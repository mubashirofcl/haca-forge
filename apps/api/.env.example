# Server & Runtime
PORT=8080
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/marketing_portal
REDIS_URL=redis://127.0.0.1:6379

# Auth & Tokens
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_min
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters_long_min
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Cookies
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=

# Email Provider (console | smtp | resend)
EMAIL_PROVIDER=console
MAIL_FROM="Marketing Portal <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# Initial Admin & Demo Seeding
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=AdminStrongPass123!
DEMO_SEED_PASSWORD=DemoSecretPass123!

# Cloudinary Direct Uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Observability (Optional)
SENTRY_DSN=

# LeadSquared (LSQ) Integration
LSQ_ACCESS_KEY=
LSQ_SECRET_KEY=
LSQ_HOST_URL=
LSQ_MOCK_MODE=true

