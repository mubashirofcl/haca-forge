# Server & Runtime
PORT=8080
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/marketing_portal
REDIS_URL=redis://localhost:6379

# Auth & Tokens
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_min
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters_long_min
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Cookies
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=

# Email Provider (console | smtp | resend)
EMAIL_PROVIDER=console
MAIL_FROM="Marketing Portal <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# Initial Admin Seeding
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=AdminStrongPass123!

# Cloudinary Direct Uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
